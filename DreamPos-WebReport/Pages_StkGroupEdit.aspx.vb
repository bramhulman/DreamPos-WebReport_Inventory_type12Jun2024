Imports System.Threading
Imports System.Net
Imports System.Text
Imports System.IO

Public Class Pages_StkGroupEdit
    Inherits System.Web.UI.Page
    Private sNameuser As String
    Private Userid As Integer
    Private icustid As Integer
    Private imodul As Integer
    Private iModPriv As Integer
    Private irptpriv As Integer
    Private irptf As Integer
    Private mfunction As New ModFunction
    Private Mdd As String = ""
    Private MTid As Integer
    Private CStkGrp As New Cls_IStkGroup


    'Private transpriv As Integer
    Public Function modulepriv() As Integer
        Dim cookie As HttpCookie = Request.Cookies("UserLogin_inv")
        Return cookie("modulepriv")

    End Function
    Public Function custid() As Integer
        Dim cookie As HttpCookie = Request.Cookies("UserLogin_inv")

        If cookie Is Nothing Then
            Return -1
        Else
            Return cookie("Custid")
        End If

    End Function

    Public Function rptpriv() As Integer
        Dim cookie As HttpCookie = Request.Cookies("UserLogin_inv")

        Return cookie("rptpriv")

    End Function
    Public Function modul() As Integer
        Dim cookie As HttpCookie = Request.Cookies("UserLogin_inv")
        Return cookie("modul")

    End Function
    Public Function rptf() As Integer
        Dim cookie As HttpCookie = Request.Cookies("UserLogin_inv")

        Return cookie("rptf")

    End Function
    Protected Sub Page_Load(sender As Object, e As EventArgs) Handles Me.Load

        'If Not (User.Identity.IsAuthenticated) Or custid() = -1 Then
        '    FormsAuthentication.RedirectToLoginPage()
        '    Exit Sub
        'End If
        If Session("username") Is Nothing Or custid() < 1 Then
            Session.Clear()
            Session.Abandon()
            Session.RemoveAll()
            FormsAuthentication.RedirectToLoginPage()
            Exit Sub
        End If
        Try
            MTid = Request.Cookies("ID").Value
            If Request.Cookies("UserLogin_inv") IsNot Nothing Then
                sNameuser = username()
                icustid = custid()
                imodul = modul()
                iModPriv = modulepriv()
                irptpriv = rptpriv()
                irptf = rptf()
                If IsPostBack = False Then
                    If MTid = 0 Then
                        hapus()
                        'loadCust()
                    Else
                        editlist(MTid)
                        ' loadCust()
                    End If

                End If
            Else
                Dim script As String = "window.onload = function(){ alert('"
                script += "Please Login"
                script += "');"
                script += "window.location = '"
                script += "../Default"
                script += " '; }"
                ClientScript.RegisterStartupScript(Me.GetType(), "Redirect", script, True)
            End If




            'yestr = CDate(Now.AddDays(-1)).ToString("yyyyMMdd")

        Catch ex As Exception
            errLog(Err.Description, "Pages_StkGroupEdit:Page_Load")
            Err.Clear()
        End Try
    End Sub

    Protected Sub Page_unLoad(sender As Object, e As EventArgs) Handles Me.Unload
    End Sub

    Public Function username() As String
        Dim cookie As HttpCookie = Request.Cookies("UserLogin_inv")
        Return cookie("userName")

    End Function

    Sub hapus()
        Try
            txtName.Text = ""
            txtNo.Text = ""
            txtNo.Enabled = True


            btnUpdate.Visible = False
            btnInsert.Visible = True
        Catch ex As Exception
            errLog(Err.Description, "Pages_StkGroupEdit:hapus")
            Err.Clear()
        End Try
    End Sub

    Sub editlist(ByVal id As String)
        Try
            Dim ds As New DataSet
            ds = CStkGrp.SelectDataset_StkGroupEdit(id, custid)
            If ds Is Nothing OrElse ds.Tables.Count = 0 Then
                Throw New InvalidOperationException("Unable to load stock group data.")
            End If
            If ds.Tables(0).Rows.Count = 0 Then
                Exit Sub
            End If

            txtNo.Text = ds.Tables(0).Rows(0).Item("code")
            txtName.Text = ds.Tables(0).Rows(0).Item("Name")


            btnUpdate.Visible = True
            btnInsert.Visible = False
        Catch ex As Exception
            errLog(Err.Description, "Pages_StkGroupEdit:editlist")
            Err.Clear()
        End Try

    End Sub

    Protected Sub btnInsert_Click(ByVal sender As Object, ByVal e As EventArgs) Handles btnInsert.Click
        insert()
    End Sub

    Protected Sub btnUpdate_Click(ByVal sender As Object, ByVal e As EventArgs) Handles btnUpdate.Click
        insert()
    End Sub

    Protected Sub btnCancel_Click(ByVal sender As Object, ByVal e As EventArgs) Handles btnCancel.Click
        Try
            'hapus()

            'mfunction.CreateCookie("ID", 0)

            Response.Redirect("~/Pages_StkGroup.aspx", False)


        Catch ex As Exception
            errLog(Err.Description, "Pages_StkGroupEdit:btnCancel_Click")
            Err.Clear()
        End Try
    End Sub


    Sub insert()
        'Dim act As Boolean

        Try
            Dim clsStockGroup As New Cls_IStkGroup
            clsStockGroup.insertStkgGroup(MTid, custid, txtNo.Text, txtName.Text, username)

            clsStockGroup = Nothing

            Response.Redirect("~/Pages_StkGroup.aspx")
        Catch ex As Exception
            errLog(Err.Description, "Pages_StkGroupEdit:insert")
            Err.Clear()
        End Try
    End Sub

    Sub fillplease()
        Dim message As String = "Please Choice Item Name"
        Dim sb As New System.Text.StringBuilder()
        Dim url As String = "~/Pages_ItemMaster.aspx"
        sb.Append("<script type = 'text/javascript'>")
        sb.Append("window.onload=function(){")
        sb.Append("alert('")
        sb.Append(message)
        sb.Append("')};")
        sb.Append("</script>")
        ClientScript.RegisterClientScriptBlock(Me.GetType(), "Alert", sb.ToString())
    End Sub

