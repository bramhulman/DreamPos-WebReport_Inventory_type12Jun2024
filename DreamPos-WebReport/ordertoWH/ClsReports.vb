    Public Function getactive_itemxTag(ByVal CustID As Integer, ByVal sItem As String) As Integer

        Dim activeitem As Integer = 1


        Dim sout As String = ""

        Try


            Dim c_Cmd As New clsDbo("")


            sout = "SELECT count(flag) FROM cld_itemxtag WHERE custid = " & CustID &
                " and item = '" & sItem & "' and flag = 2"

            If c_Cmd.ExecuteScalar(sout, 0) > 0 Then
                activeitem = 0
            End If

            c_Cmd.dispose()
            c_Cmd = Nothing

        Catch ex As Exception
            errLog(Err.Description, "clsReport:getactive_itemxTag")
            Err.Clear()
        End Try

        Return activeitem
