    Private Function menuItem(ByVal ccid As String, ByVal custID As Integer, ByVal usr As String, ByVal modpriv As Integer) As DataSet
        Dim dsRslt As New DataSet
        Dim scc As String = ""
        Try
            Dim connDb As New clsDbConn(ServerString)

            If modpriv And usrModulepriv.moduleuser = usrModulepriv.moduleuser Then
                If ccid = "0" Or ccid = "" Then
                    scc = " and icc.ccid in (Select Store From cld_userxstore where user = '" & usr & "')"
                Else
                    scc = " and icc.ccid in (" & ccid & ")"
                End If
            Else
                If ccid = "0" Or ccid = "" Then
                    scc = ""
                Else
                    scc = " and icc.ccid in (" & ccid & ")"
                End If
            End If

            With connDb
                .resetCmd("SELECT item.Itemno,item.rid,item.iid,item.itype, ItemName,cc.name, item.Custid, Price,
                 IFNULL(CASE
                 WHEN item.rid IS NOT NULL AND item.itype=2 THEN rcc.cost
                 WHEN item.iid IS NOT NULL AND item.itype=1 THEN ICC.COST
                 END,0) AS cost
                  ,
                  IFNULL(CASE
                 WHEN item.rid IS NOT NULL AND item.itype=2 THEN price-rcc.cost
                 WHEN item.iid IS NOT NULL AND item.itype=1 THEN price-ICC.COST
                 END,0) AS profit
                FROM cld_itemmaster item
                 JOIN cld_itemmaster_cc icc ON item.itemno = icc.itemno AND item.custid = icc.custid
                 JOIN cld_inv_cc cc ON cc.custid = item.custid AND cc.id = icc.ccid
                 LEFT JOIN cld_inv_rcp rcp ON rcp.id = item.rid AND rcp.custid = item.custid
                 LEFT JOIN cld_inv_rcp_cc rcc ON rcc.rcpid = rcp.id AND rcc.custid = item.custid  AND rcc.ccid = cc.id " &
                                          "WHERE (item.`custId` =@custID OR @custID=0) " &
                                scc &
                          "ORDER BY profit Desc")

                .addParam(custID, "@custID", MySqlDbType.Int32)

                dsRslt = .selectDataset

                .dispose()
            End With

            connDb = Nothing
        Catch ex As Exception
            errLog(Err.Description, "clsReports:menuItem")
            Err.Clear()
        End Try

        Return dsRslt

    End Function
