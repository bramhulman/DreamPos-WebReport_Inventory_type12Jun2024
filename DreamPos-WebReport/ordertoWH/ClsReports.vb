    Private Function ItemHourChart(ByVal paramFrom As Date, ByVal paramTo As Date, ByVal outletNo As String, ByVal memberID As Integer, ByVal usr As String, ByVal modpriv As Integer) As DataSet
        Dim dsRslt As New DataSet

        Try
            Dim connDb As New clsDbConn(ServerString)
            If modpriv And usrModulepriv.moduleuser = usrModulepriv.moduleuser Then
                connDb.resetCmd("SELECT HOUR(mst.transdate) AS jam" &
                                         ", count(*) AS Qty " &
                                         ", SUM(mst.total) AS Amount " &
                                      "FROM cld_salesmaster mst " &
                                         "inner join cld_member m on (m.Number = mst.MemberNo and m.custid = mst.custid) " &
                                      "WHERE mst.flag =1 AND mst.BusiDate >=@paramFrom AND mst.BusiDate <=@paramTo " &
                                        "AND ((mst.olNumber=@outletNo AND @outletNo<>'') or (@outletNo='' AND (mst.olid IN (Select Store from cld_userxstore where user = '" & usr & "'))) ) " &
                                        " AND (m.ID =@memberID or @memberID=0) " &
                                      "GROUP BY HOUR(mst.transdate) " &
                                      "ORDER BY HOUR(mst.transdate)")

            Else
                connDb.resetCmd("SELECT HOUR(mst.transdate) AS jam" &
                                         ", count(*) AS Qty " &
                                         ", SUM(mst.total) AS Amount " &
                                      "FROM cld_salesmaster mst " &
                                         "inner join cld_member m on (m.Number = mst.MemberNo and m.custid = mst.custid) " &
                                      "WHERE mst.flag =1 AND mst.BusiDate >=@paramFrom AND mst.BusiDate <=@paramTo AND (mst.olNumber=@outletNo  OR @outletNo = '') " &
                                        " AND (m.ID =@memberID or @memberID=0) " &
                                      "GROUP BY HOUR(mst.transdate) " &
                                      "ORDER BY HOUR(mst.transdate)")
            End If
            connDb.addParam(paramFrom, "@paramFrom", MySqlDbType.DateTime)
            connDb.addParam(paramTo, "@paramTo", MySqlDbType.DateTime)
            connDb.addParam(outletNo, "@outletNo", MySqlDbType.VarChar)
            connDb.addParam(memberID, "@memberID", MySqlDbType.Int32)

            dsRslt = connDb.selectDataset

            connDb.dispose()
            connDb = Nothing

        Catch ex As Exception
            errLog(Err.Description, "ClsReports:itemByQty")
            Err.Clear()
        End Try

        Return dsRslt

    End Function

