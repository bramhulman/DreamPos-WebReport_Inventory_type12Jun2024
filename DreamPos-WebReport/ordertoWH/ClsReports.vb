    Private Function orderFromStoreDetailVariantgv(ByVal paramFrom As Date, ByVal paramTo As Date, ByVal custID As Integer, ByVal usr As String, ByVal modpriv As Integer, ByVal ccid As String) As DataSet
        Dim dsRslt As New DataSet
        'Melissa Update 30 Mar 21
        Dim strCcid As String = ""

        Try
            Dim c_Cmd As New clsDbo(ServerString)

            With c_Cmd
                If modpriv And usrModulepriv.moduleuser = usrModulepriv.moduleuser Then
                    If ccid = "0" Or ccid = "" Then
                        strCcid = " and w.ccTo in (select id from cld_inv_cc where olid in (Select Store From cld_userxstore where user = '" & usr & "'))"
                    Else
                        strCcid = " and w.ccTo in (" & ccid & ")"
                    End If
                Else
                    If ccid = "0" Or ccid = "" Then
                        strCcid = ""
                    Else
                        strCcid = " and w.ccTo in (" & ccid & ")"
                    End If
                End If
                'Melissa Update 30 Mar 21
                .resetCmd("SELECT w.ID As DocNo, w.ccFromNm AS Warehouse, w.ccToNm AS CcName, d.stk_name as Stock ,ifnull((TRIM(TRAILING '.' FROM(CAST(TRIM(TRAILING '0' FROM d.TotalU2)AS char)))),0) AS OrderQty, ifnull((TRIM(TRAILING '.' FROM(CAST(TRIM(TRAILING '0' FROM d.u1Del)AS char)))),0) AS DelQty, 
                        ifnull((TRIM(TRAILING '.' FROM(CAST(TRIM(TRAILING '0' FROM d.u1Rcv)AS char)))),0) AS RcvQty, d.U1_nm AS Unit, FORMAT(d.cost, 2,'de_DE') AS Cost, ifnull((TRIM(TRAILING '.' FROM(CAST(TRIM(TRAILING '0' FROM d.u1Del - d.u1Rcv)AS char)))),0) AS VariantQty , 
                        FORMAT((d.u1Del - d.u1Rcv) * d.cost, 2,'de_DE') AS VariantCost " &
                            "FROM cld_inv_w w INNER JOIN cld_inv_w_dtl d ON w.ID = d.wID " &
                            "WHERE w.exDelDate >= @paramFrom AND w.exDelDate <=@paramTo " &
                                "AND w.CustID=@custID " &
