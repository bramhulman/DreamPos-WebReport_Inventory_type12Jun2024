            connDb.resetCmd("SELECT a.id,a.`CreatedBy`,a.`CreatedDate`,a.`exDelDate`, a.`ccFromNm`, a.`ccToNm`, c.`Name`, c.`Number`, b.`U1`,c.`Unit1`, b.`u1Del`, b.`u1Rcv`, SUM(b.`U1` - b.`u1Del`) AS deldif, c.`Unit2`, SUM(b.`u1Del` - b.`u1Rcv`) AS rcvdif, c.`Unit3` " &
           "FROM cld_inv_w a INNER JOIN cld_inv_w_dtl b ON a.`ID` = b.`wID` and a.custid = b.custid " &
           "INNER JOIN cld_inv_stk c ON b.`stk_id` = c.`ID` and b.custid = c.custid " &
           "WHERE a.id =@paramOrderId AND a.ccTO=@ccID  AND a.`custid` =@custID " &
           "GROUP BY c.`Number`, a.id ORDER BY a.`CreatedDate` ")

            connDb.addParam(order_req, "@paramOrderId", MySqlDbType.VarChar)
            connDb.addParam(ccID, "@ccID", MySqlDbType.Int32)
            connDb.addParam(custID, "@custID", MySqlDbType.Int32)

            dsRslt = connDb.selectDataset

            connDb.dispose()
