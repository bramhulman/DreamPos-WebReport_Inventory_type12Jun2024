    Public Function getDataset(ByVal namaRpt As String, ByVal rptParam As ClsParamRpt) As DataSet
        Dim dsRslt As New DataSet

        Try
            Select Case namaRpt.ToUpper

                Case "Kartu Stock".ToUpper 'Case "stkOnHand".ToUpper
                    dsRslt = kartustock(rptParam.paramFrom, rptParam.paramTo, rptParam.custID, rptParam.usr, rptParam.Modpriv, rptParam.ccID, rptParam.stockstr)
                Case "Running Cost".ToUpper 'Case "stkOnHand".ToUpper
                    dsRslt = runningcostgv(rptParam.paramFrom, rptParam.paramTo, rptParam.custID, rptParam.usr, rptParam.Modpriv, rptParam.ccID, rptParam.stockstr)

                Case "All Trans".ToUpper 'Case "stkOnHand".ToUpper
                    dsRslt = alltransgv(rptParam.paramFrom, rptParam.paramTo, rptParam.custID, rptParam.usr, rptParam.Modpriv, rptParam.ccID, rptParam.stockstr)


            End Select

        Catch ex As Exception
            errLog(Err.Description, "ClsReport:reportDataset")
            Err.Clear()
        End Try

        Return dsRslt

    End Function

