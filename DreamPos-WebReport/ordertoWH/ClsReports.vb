                                 stk_no,stk_name,cc ccid,cc_name,cost,ttlstock qty FROM `cld_inv_trans` WHERE invdate>=@paramFrom AND invdate<=@paramTo
                               UNION
	                           SELECT '6_usage' AS trans,'' idtrans ,ADDDATE(ADDDATE(invdate, INTERVAL 1 DAY),INTERVAL -1 MINUTE) createddate, stkid,
	                             stkno,stkname, ccid,ccname,cost,usageqty qty FROM `cld_inv_transstockcls` WHERE invdate>=@paramFrom AND invdate<=@paramTo
	                          UNION
                                SELECT '6_BPout' AS trans,'' idtrans ,ADDDATE(ADDDATE(invdate, INTERVAL 1 DAY),INTERVAL -1 MINUTE) createddate, stkid,
	                             stkno,stkname, ccid,ccname,cost,BPout qty FROM `cld_inv_transstockcls` WHERE invdate>=@paramFrom AND invdate<=@paramTo
	                          UNION
                                     SELECT '9_closing' trans,'' idtrans,ADDDATE(ADDDATE(invdate, INTERVAL 1 DAY),INTERVAL -1 MINUTE) createddate,stkid,stkno,stkname,ccid,ccname, cost,ttlqty qty FROM `cld_inv_transstockcls` 
                                     WHERE invdate>=@paramFrom AND invdate<=@paramTo) tbl1 
                            RIGHT JOIN cld_inv_stk stk ON tbl1.stkid = stk.id
                            WHERE tbl1.createddate < '" & Now.AddDays(1).Date.ToString("yyyy-MM-dd HH:mm:ss") & "' " & scc & "" & sstock & "
                             ORDER BY ccname,stkno,createddate,trans")

                'AND closeqty<>0
                .addParam(paramFrom, "@paramFrom", MySqlDbType.DateTime)
                .addParam(paramTo, "@paramTo", MySqlDbType.DateTime)

                .addParam(custID, "@custID", MySqlDbType.Int32)
                dsRslt = .selectDataset

                .dispose()

            End With

            dbConn = Nothing
        Catch ex As Exception
            errLog(Err.Description, "ClsReports:alltransgv")
            Err.Clear()
        End Try

        Return dsRslt

    End Function
    Public Function cal_usage(ByVal paramFrom As Date, ByVal paramTo As Date, ByVal custID As Integer, ByVal usr As String, ByVal modpriv As Integer, ByVal ordercust As String, Optional ByVal linkid As String = "") As DataSet
        Dim dsRslt As New DataSet
        Try
            Dim dbConn As New clsDbConn(ServerString)
            Dim scust As String = ""
            Dim sstock As String = ""
            Dim snumber As String = ""
            'untuk mengatasi hh:mm:ss
            'paramTo = paramTo.AddDays(1)

            With dbConn
                If linkid = "" Then
                    snumber = ""
                Else
                    snumber = "and smno = '" & linkid & "'"
                End If
                If ordercust = 0 Then
                    scust = ""
                Else
                    scust = " and ordercust in (" & ordercust & ")"
                End If





                .resetCmd("SELECT DATE_FORMAT(invdate,'%d-%b-%Y') AS 'Sales Date',cc_name,stk_no,stk_name,sum(ttlStock) Qty,stk.unit2 'Unit',DATE_FORMAT(sm.transdate,'%d-%b-%Y') AS 'Created Date'
                            FROM `cld_inv_transusage_cpo` tu
                            INNER JOIN cld_inv_stk stk ON stk.ID = tu.stk_Id AND stk.CustID = tu.custId
                            join `cld_salesmaster_cpo` sm on tu.smno = sm.number
                            WHERE invdate>=@paramFrom AND invdate<=@paramTo " & snumber & "
                             " & scust & " GROUP BY cc_name,stk_no,invdate
                             ORDER BY cc_name,stk_no,invdate")

                'AND closeqty<>0
                .addParam(paramFrom, "@paramFrom", MySqlDbType.DateTime)
                .addParam(paramTo, "@paramTo", MySqlDbType.DateTime)

                .addParam(custID, "@custID", MySqlDbType.Int32)
                dsRslt = .selectDataset

                .dispose()

            End With

            dbConn = Nothing
        Catch ex As Exception
            errLog(Err.Description, "ClsReports:cal_usage")
            Err.Clear()
        End Try

        Return dsRslt

    End Function
End Class
