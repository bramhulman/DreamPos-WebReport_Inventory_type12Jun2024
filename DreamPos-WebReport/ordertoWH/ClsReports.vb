    Public Function DepositSum(ByVal paramFrom As Date, ByVal paramTo As Date, ByVal outletNo As String, ByVal custID As Integer,
                               ByVal usr As String, ByVal modpriv As Integer, ByVal memberNo As String) As DataSet
        Dim dsRslt As New DataSet

        Try
            Dim connDb As New clsDbConn(ServerString)
            If modpriv And usrModulepriv.moduleuser = usrModulepriv.moduleuser Then

                If outletNo = "" Then

                    connDb.resetCmd("SELECT m.Number, m.name, sum(if((d.DepGet)>=0,d.DepGet,0)) as deposit, SUM(IF((d.DepGet)<0,d.DepGet,0)) AS deposituse, sum(d.DepGet), case d.flag when 1 then 'deposit' when 2 then 'use deposit' when 0 then 'open deposit' end as type " &
                                   "FROM cld_memberdeposit d INNER JOIN cld_member m ON (d.memberNo = m.number) INNER JOIN cld_outlet o ON(d.OlNumber = o.Kode AND d.Custid = o.custID) " &
                              "where d.flag <> 3 and d.Busidate >=@paramFrom AND d.Busidate <=@paramTo " &
                                    "AND (o.ID in (Select Store From cld_userxstore where user = '" & usr & "')) " &
                                    "AND (d.memberNo = @memberNo OR @memberNo='') " &
                                   "AND (d.CustID =@custID OR @custID=0) GROUP BY m.Number ORDER BY SUM(d.DepGet) DESC ")

                Else

                    connDb.resetCmd("SELECT m.Number, m.name, sum(if((d.DepGet)>=0,d.DepGet,0)) as deposit, SUM(IF((d.DepGet)<0,d.DepGet,0)) AS deposituse, sum(d.DepGet), case d.flag when 1 then 'deposit' when 2 then 'use deposit' when 0 then 'open deposit' end as type " &
                                   "FROM cld_memberdeposit d INNER JOIN cld_member m ON (d.memberNo = m.number) INNER JOIN cld_outlet o ON(d.OlNumber = o.Kode AND d.Custid = o.custID)) " &
                              "where d.flag <> 3 and d.Busidate >=@paramFrom AND d.Busidate <=@paramTo AND (d.olNumber=@outletNo) " &
                                    "AND (d.memberNo = @memberNo OR @memberNo='') " &
                                   "AND (d.CustID =@custID OR @custID=0) GROUP BY m.Number ORDER BY SUM(d.DepGet) DESC ")

                End If

            Else
                connDb.resetCmd("SELECT m.Number, m.name, sum(if((d.DepGet)>=0,d.DepGet,0)) as deposit, SUM(IF((d.DepGet)<0,d.DepGet,0)) AS deposituse, sum(d.DepGet), case d.flag when 1 then 'deposit' when 2 then 'use deposit' when 0 then 'open deposit' end as deposit " &
                                 "FROM cld_memberdeposit d INNER JOIN cld_member m ON (d.memberNo = m.number) INNER JOIN cld_outlet o ON(d.OlNumber = o.Kode AND d.Custid = o.custID) " &
                              "where d.flag <> 3 and d.Busidate >=@paramFrom AND d.Busidate <=@paramTo AND (d.olNumber =@outletNo or @outletNo = '') " &
                                    "AND (d.memberNo = @memberNo OR @memberNo='') " &
                                   "AND (d.CustID =@custID OR @custID=0) GROUP BY m.Number ORDER BY SUM(d.DepGet) DESC ")
            End If
            connDb.addParam(paramFrom, "@paramFrom", MySqlDbType.DateTime)
            connDb.addParam(paramTo, "@paramTo", MySqlDbType.DateTime)

            If modpriv And usrModulepriv.moduleuser = usrModulepriv.moduleuser Then
                If outletNo <> "" Then
                    connDb.addParam(outletNo, "@outletNo", MySqlDbType.VarChar)
                End If
            Else
                connDb.addParam(outletNo, "@outletNo", MySqlDbType.VarChar)
            End If

            connDb.addParam(memberNo, "@memberNo", MySqlDbType.String)
            connDb.addParam(custID, "@custID", MySqlDbType.Int32)


            dsRslt = connDb.selectDataset

            connDb.dispose()
            connDb = Nothing

        Catch ex As Exception
            errLog(Err.Description, "ClsReports:memberDeposit1")
            Err.Clear()
        End Try

        Return dsRslt
    End Function

