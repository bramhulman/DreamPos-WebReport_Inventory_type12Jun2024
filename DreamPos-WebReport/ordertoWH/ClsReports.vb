        "CROSS JOIN " &
                "(Select SUM(sm.total) AS SUM
                        FROM cld_sumpaymentdaily SM " &
                                "INNER JOIN cld_outlet o ON sm.`olid` = o.`ID` AND sm.`olnumber` = o.`kode` AND sm.`custid` = o.`custid` " &
