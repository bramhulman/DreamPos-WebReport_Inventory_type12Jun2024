        Try

            Dim connDb As New clsDbConn(ServerString)
            If modpriv And usrModulepriv.moduleuser = usrModulepriv.moduleuser Then
                If ccid = "0" Or ccid = "" Then
                    scc = " and rcv.cc in (select id from cld_inv_cc where olid in (Select Store From cld_userxstore where user = '" & usr & "'))"
                Else
                    scc = " and rcv.cc in (" & ccid & ")"
                End If
            Else
                If ccid = "0" Or ccid = "" Then
                    scc = ""
                Else
                    scc = " and rcv.cc in (" & ccid & ")"
                End If
            End If
            connDb.resetCmd("(SELECT rcv.id as DocNo, rcv.do as DO, supp.name AS Supplier, " &
                                "CASE rcv.flag WHEN 1 THEN 'submit' ELSE 'finish' END AS Status,FORMAT(rcv.doctot, 2,'de_DE') AS 'Total', " &
                                "CASE rcv.tipe WHEN 1 THEN 'Receiving' ELSE 'Return' END AS Tipe, " &
