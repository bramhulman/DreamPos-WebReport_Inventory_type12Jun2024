    Public Function stk_req_rpt(ByVal paramFrom As Date, ByVal paramTo As Date, ByVal custID As Integer, ByVal outletNO As String, ByVal usr As String, ByVal modpriv As Integer) As DataSet
        Dim dsRslt As New DataSet

        Try

            Dim connDb As New clsDbConn(ServerString)
            If modpriv And usrModulepriv.moduleuser = usrModulepriv.moduleuser Then
                connDb.resetCmd("SELECT a.id, a.`DelID`,a.`CreatedBy`,a.`CreatedDate`,a.`exDelDate`,a.`DelDate`, a.rcvDate, a.`ccFromNm`, a.`ccToNm`, d.`olId`, b.`stk_id` AS stkid, b.`stk_name` AS NAME, c.`Number`, b.`U1`,c.`Unit1`, b.`u1Del`, b.`u1Rcv`, (b.`U1` - b.`u1Del`) AS deldif, (b.`u1Del` - b.`u1Rcv`) AS rcvdif,  b.cost " &
                "FROM cld_inv_w a INNER JOIN cld_inv_w_dtl b ON a.`ID` = b.`wID` and a.`custid` = b.`custid` INNER JOIN cld_inv_stk c ON b.`stk_id` = c.`ID` and b.`custid` = c.`custid` INNER JOIN cld_inv_cc d ON a.`ccTo` = d.`ID` and a.`custid` = d.`custid` INNER JOIN cld_outlet o ON d.`olId` = o.`ID` and d.`custid` = o.`custid` " &
                "WHERE a.CreatedDate >=@paramFrom AND a.CreatedDate <=@paramTo AND (o.Kode=@outletNo or o.ID in (Select Store From cld_userxstore where user = '" & usr & "')) AND (a.`custid` =@custID OR @custID=0) " &
                "GROUP BY c.`Number`, a.id ORDER BY a.`CreatedDate` ")

            Else

                connDb.resetCmd("SELECT a.id, a.`DelID`,a.`CreatedBy`,a.`CreatedDate`,a.`exDelDate`,a.`DelDate`, a.rcvDate, a.`ccFromNm`, a.`ccToNm`, d.`olId`, b.`stk_id` AS stkid, b.`stk_name` AS NAME, c.`Number`, b.`U1`,c.`Unit1`, b.`u1Del`, b.`u1Rcv`, (b.`U1` - b.`u1Del`) AS deldif, (b.`u1Del` - b.`u1Rcv`) AS rcvdif,  b.cost " &
                "FROM cld_inv_w a INNER JOIN cld_inv_w_dtl b ON a.`ID` = b.`wID` and a.`custid` = b.`custid` INNER JOIN cld_inv_stk c ON b.`stk_id` = c.`ID` and b.`custid` = c.`custid` INNER JOIN cld_inv_cc d ON a.`ccTo` = d.`ID` and a.`custid` = d.`custid` INNER JOIN cld_outlet o ON d.`olId` = o.`ID` and d.`custid` = o.`custid` " &
                "WHERE a.CreatedDate >= @paramFrom AND a.CreatedDate <= @paramTo AND (o.Kode=@outletNo or @outletNo = '') AND (a.`custid` =@custID OR @custID=0) " &
                "GROUP BY c.`Number`, a.id ORDER BY a.`CreatedDate` ")
            End If
            connDb.addParam(paramFrom, "@paramFrom", MySqlDbType.DateTime)
            connDb.addParam(paramTo, "@paramTo", MySqlDbType.DateTime)
            connDb.addParam(outletNO, "@outletNo", MySqlDbType.VarChar)
            connDb.addParam(custID, "@custID", MySqlDbType.Int32)

            dsRslt = connDb.selectDataset

            connDb.dispose()
            connDb = Nothing

        Catch ex As Exception
            errLog(Err.Description, "ClsReports:orderwarehouse")
            Err.Clear()
        End Try

        Return dsRslt
    End Function

