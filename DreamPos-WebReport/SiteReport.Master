  <style type="text/css">
                .style1
        {
            width: 72px;
            background-color:#DFDFFF;
            color: #000000;
        }
        
       #leftContent 
        {
            background-color:#DFDFFF;
            width: 244px;    
            padding: 10px;
            font-size: 90%;
            text-align: left;
            position: absolute;
            top: 0px;
            margin-top: 0px;
            left: -1px;
            margin-left:0px;
	        height: 1080px;
	        color:Black;
            }
            
        #leftContent h3 {
            text-transform: uppercase;
            letter-spacing: 2px;
            text-align: center;
            border-top: dotted 1px #660;
            border-bottom: dotted 1px #660;
            color:Black;
            }

        #leftContent h4 
        {
            text-transform: uppercase;
            letter-spacing: 2px;
            text-align: center;
            border-top: dotted 1px #660;
            border-bottom: dotted 1px #660;
            color:Black;
            }
            
        #mainContent {
            text-align: left;
            margin-left: 265px;
            padding: 10px;
	        height: 1080px;
	        background-color:#DFDFFF;
	        width: 820px; 
	        margin-right: 0px;
	        color:Black;
            }

        #content{
	            background:#FFF; /*369*/
	            height:880px;
	            width:950px;
	            position:relative;
	            top:1200px;
	            z-index:0;
                }
        .modal{
            position: fixed;
            z-index: 999;
            height: 100%;
            width: 100%;
            top: 0;
            left: 0;
            background-color: Black;
            filter: alpha(opacity=60);
            opacity: 0.6;
            -moz-opacity: 0.8;
        }
        
         .modalBackground
        {
            background-color: Black;
            filter: alpha(opacity=90);
            opacity: 0.8;
        }
         .modalPopup
        {
            background-color: #FFFFFF;
            border-width: 3px;
            border-style: solid;
            border-color: black;
            padding-top: 10px;
            padding-left: 10px;
            width: 375px;
            height: 400px;
            overflow-x:auto;
        }

         /*Update 21 Februari 2020*/
        .modalPopupProgress
        {
            background-color: #FFFFFF;
            border-width: 3px;
            border-style: solid;
            border-color: lightgrey;
            padding-top: 10px;
            padding-left: 10px;
            width: 375px;
            height: 400px;
            overflow-x:auto;
            border-radius:10px;
        }
         /*Update 21 Februari 2020*/
        .center
        {
            z-index: 1000;
            margin: 300px auto;
            padding: 10px;
            width: 130px;
            background-color: White;
            border-radius: 10px;
            filter: alpha(opacity=100);
            opacity: 1;
            -moz-opacity: 1;
        }
        .center img
        {
            height: 128px;
            width: 128px;
        }
          .btnstyle
        {
         text-align: center;
        }
        .menu
    #tblEmpDetails
    {
        margin-right: 0px;
    }
.dropbtn {

    background-color: #3a4f63;
    color: white;
    width:180px;
    padding: 10px 20px;
    border: none;
    text-align :left  ;
    vertical-align:middle;
}

.dropdown {
    width:200px;
    position: relative;
    display: inline-block;
}

.dropdown-content {
    display: none;
    position: absolute;
    background-color: #f1f1f1;
    min-width: 180px;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
    z-index: 1;
}

.dropdown-content a {
    color: black;
    padding:8px 16px;
    text-align :right ;
    text-decoration: none;
    display: block;
}

.dropdown-content a:hover {background-color: #ddd;}

.dropdown:hover .dropdown-content {display: block;}

.dropdown:hover .dropbtn {background-color: #f1f1f1;color: black;}
  .style22
        {
            color: #FFFFFF;
            width: 73%;
            background: #3a4f63;
            padding:5px;
        }
   .style25
        {
            color: #FFFFFF;
            width: 17%;
            background: #3a4f63;
            padding:5px;
        }
     .style17
        {
            color: #FFFFFF;
            width: 10%;
            background: #3a4f63;
            padding:5px;
        }
     .menutab
        {
            padding: 10px 10px 10px 10px;
            font: normal 120%;
            /*height: 30px;*/
            color: #1D1D1D;
            border-radius: 15px 15px 15px 15px;
            -moz-border-radius: 15px 15px 15px 15px;
            -webkit-border: 15px 15px 15px 15px;
            -webkit-box-shadow: rgba(0, 0, 0, 0.5) 0px 0px 5px;
            -moz-box-shadow: rgba(0, 0, 0, 0.5) 0px 0px 5px;
            box-shadow: rgba(0, 0, 0, 0.5) 0px 0px 5px;
        }
